{
  "$schema": "https://json-schema.org/draft-07/schema",
  "type": "object",
  "required": ["trustDomain", "server", "agent", "storage"],
  "properties": {
    "trustDomain": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-z0-9]([a-z0-9.-]*[a-z0-9])?$"
    },
    "server": {
      "type": "object",
      "required": ["port", "replicas", "image"],
      "properties": {
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "replicas": { "type": "integer", "minimum": 1 },
        "image": {
          "type": "object",
          "required": ["repository", "tag"],
          "properties": {
            "repository": { "type": "string", "minLength": 1 },
            "tag": { "type": "string", "minLength": 1 },
            "pullPolicy": { "type": "string", "enum": ["Always", "IfNotPresent", "Never"] }
          }
        },
        "service": {
          "type": "object",
          "properties": {
            "type": { "type": "string", "enum": ["ClusterIP", "NodePort", "LoadBalancer"] }
          }
        }
      }
    },
    "agent": {
      "type": "object",
      "required": ["image"],
      "properties": {
        "image": {
          "type": "object",
          "required": ["repository", "tag"],
          "properties": {
            "repository": { "type": "string", "minLength": 1 },
            "tag": { "type": "string", "minLength": 1 },
            "pullPolicy": { "type": "string", "enum": ["Always", "IfNotPresent", "Never"] }
          }
        }
      }
    },
    "storage": {
      "type": "object",
      "required": ["postgres"],
      "properties": {
        "size": { "type": "string", "pattern": "^[0-9]+(Mi|Gi|Ti)$" },
        "class": { "type": "string" },
        "postgres": {
          "type": "object",
          "required": ["host", "port", "db", "user"],
          "properties": {
            "host": { "type": "string", "minLength": 1 },
            "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
            "db": { "type": "string", "minLength": 1 },
            "user": { "type": "string", "minLength": 1 },
            "sslmode": { "type": "string", "enum": ["disable", "require", "verify-ca", "verify-full"] },
            "password": { "type": "string" },
            "existingSecret": {
              "type": "object",
              "properties": {
                "name": { "type": "string" },
                "key": { "type": "string", "minLength": 1 }
              }
            }
          }
        }
      }
    }
  }
}
